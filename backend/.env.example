# Copy to backend/.env before running. Never commit the filled-in file.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017/resolveai
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/resolveai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/resolveai

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# --- Gemini (backend only; never shipped to the browser) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Cognee ---
COGNEE_API_URL=
COGNEE_API_KEY=
COGNEE_DATASET=resolveai

# --- n8n Cloud (backend only) ---
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_PATH_RECONCILIATION=resolveai-reconciliation
N8N_PATH_REFUND=resolveai-refund
N8N_PATH_ESCALATION=resolveai-escalation
N8N_PATH_NOTIFICATION=resolveai-notification

# --- Policy thresholds enforced by the backend ---
AUTONOMOUS_REFUND_CEILING=5000
MIN_AUTONOMOUS_CONFIDENCE=0.8
MAX_ACTION_ATTEMPTS=2

# n8n/Gmail inbound webhook protection
EMAIL_INGEST_SECRET=replace-with-long-random-secret
